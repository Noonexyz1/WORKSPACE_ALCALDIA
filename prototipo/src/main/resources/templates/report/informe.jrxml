				<text><![CDATA[INFORME DE SOLICITUD DE FOTOCOPIAS]]></text>
			</element>
			<element kind="textField" uuid="14628743-8c24-46cc-94f5-0579f47506f2" x="157" y="0" width="357" height="13" vTextAlign="Middle">
				<expression><![CDATA[$P{funcionarioTo}]]></expression>
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
			</element>
			<element kind="textField" uuid="68f5e11a-0c63-4e72-a8ae-4a3ddf2c8930" x="157" y="44" width="357" height="13" vTextAlign="Middle">
