			<element kind="staticText" uuid="20a9aaea-4ed1-4683-9558-0411c6fa2f57" x="50" y="176" width="150" height="15">
				<text><![CDATA[De mi mayor consideracion:]]></text>
			</element>
			<element kind="staticText" uuid="73698534-d06f-42e7-bd2a-871131304446" x="50" y="194" width="464" height="30" hTextAlign="Justified">
				<text><![CDATA[            Mediante la presente, tengo a bien saludarle y desearle éxitos en las funciones que desempeña en beneficio de la institución.]]></text>
			</element>
			<element kind="textField" uuid="2abe62bb-904b-4938-8541-07dbaf4ad078" x="50" y="227" width="464" height="42" hTextAlign="Justified">
				<expression><![CDATA["           El motivo de la presente es solicitar que, a través de su instrucción, se autoricen las fotocopias pertinentes descritas en la siguiente tabla para la " + $P{nombreOrganizacion} + ":"]]></expression>
			</element>
